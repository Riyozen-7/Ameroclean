# AMERO order backend configuration.
# Copy this file to server/.env and fill in your real values.
# NEVER commit server/.env to git — it holds your bot credentials.

# Telegram bot token (created via @BotFather). Server-side only.
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Chat or channel ID where new orders are posted.
TELEGRAM_CHAT_ID=your_chat_id_here

# Shared admin key that guards the /api/admin/* endpoints and the restock
# endpoint. Keep it long and random. Set the SAME value on the Cloudflare
# Worker (wrangler secret put ADMIN_KEY) in production.
ADMIN_KEY=your_long_random_admin_key_here

# Optional — defaults to 3000.
PORT=3000